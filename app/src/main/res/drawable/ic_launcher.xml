<?xml version="1.0" encoding="utf-8"?>
<!--
  即 application 的 banner（manifest 里 android:banner 引用）。原注释说它兼作
  API 24-25 的图标兜底——其实没接上：图标走的是 @mipmap/ic_launcher，而 mipmap 下
  当时只有 anydpi-v26 一份，Android 7 解析不到就退回了系统默认机器人图标。
  API 24-25 的图标兜底已改为 mipmap-<dpi>/ic_launcher.png 位图。
  API 26+ 的手机 / 平板 / TV 桌面用 mipmap-anydpi-v26/ic_launcher.xml（自适应图标）。

  注：方形图标被当作 320x180 的 TV banner 用，leanback 主屏上会拉伸/留白。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:fillColor="#101418"
        android:pathData="M54,54m-52,0a52,52 0,1 1,104 0a52,52 0,1 1,-104 0" />
    <path android:fillColor="#4CC2A5"
        android:pathData="M30,42 h48 a4,4 0 0 1 4,4 v24 a4,4 0 0 1 -4,4 h-48 a4,4 0 0 1 -4,-4 v-24 a4,4 0 0 1 4,-4 z" />
    <path android:fillColor="#101418"
        android:pathData="M40,52 h28 v4 h-28 z M40,60 h18 v4 h-18 z" />
</vector>
